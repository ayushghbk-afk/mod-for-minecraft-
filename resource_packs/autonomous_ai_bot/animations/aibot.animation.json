{
  "format_version": "1.8.0",
  "animations": {
    "animation.aibot.idle": {
      "loop": true,
      "bones": {
        "leftArm": { "rotation": [0, 0, "-2.5 - math.cos(query.life_time * 40.0) * 1.5"] },
        "rightArm": { "rotation": [0, 0, "2.5 + math.cos(query.life_time * 40.0) * 1.5"] },
        "body": { "rotation": [0, 0, "math.cos(query.life_time * 25.0) * 0.4"] }
      }
    },
    "animation.aibot.walk": {
      "loop": true,
      "animation_length": 0.6667,
      "bones": {
