          "rotation": ["-math.cos(query.anim_time * 360.0) * 40.0 * variable.aibot_move", 0, 0]
        },
        "leftArm": {
          "rotation": ["-math.cos(query.anim_time * 360.0) * 32.0 * variable.aibot_move", 0, "-2.0 * variable.aibot_move"]
        },
        "rightArm": {
          "rotation": ["math.cos(query.anim_time * 360.0) * 32.0 * variable.aibot_move", 0, "2.0 * variable.aibot_move"]
        },
        "body": {
          "rotation": ["math.sin(query.anim_time * 720.0) * 1.5 * variable.aibot_move", 0, 0],
          "position": [0, "math.abs(math.cos(query.anim_time * 360.0)) * 0.6 * variable.aibot_move", 0]
        },
        "head": {
          "rotation": ["math.sin(query.anim_time * 360.0) * 2.0 * variable.aibot_move", 0, 0]
